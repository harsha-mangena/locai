{
  "name": "locai-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "LocAI — the universal, open-source, zero-config local AI runtime. Run powerful LLMs fully locally on any device.",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "profile": "node --experimental-strip-types packages/core/src/cli/profile.ts",
    "plan": "node --experimental-strip-types packages/core/src/cli/plan.ts",
    "run:chat": "node --experimental-strip-types packages/core/src/cli/run.ts",
    "serve": "node --experimental-strip-types packages/core/src/cli/serve.ts",
    "dev:dashboard": "npm run dev --workspace=packages/dashboard",
    "build:dashboard": "npm run build --workspace=packages/dashboard"
  },
  "engines": {
    "node": ">=22"
  }
}
